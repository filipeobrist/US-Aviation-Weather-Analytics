    <connection>TAD</connection>
    <sql>SELECT
    f.*,
    -- Time IDs
    t1.id AS time_arr_actual_id,
    t2.id AS time_arr_estimated_id,
    t3.id AS time_dep_actual_id,
    t4.id AS time_dep_estimated_id,
    -- Delay IDs
    d1.id AS delay_arrival_id,
    d2.id AS delay_departure_id,
    -- Weather IDs
    w_orig.id AS weather_departure_id,
    w_dest.id AS weather_arrival_id,
    -- Placeholder for Airport IDs (See note below)
    f.origin_id AS airport_departure_id,
    f.destination_id AS airport_arrival_id
FROM "public".flights_temporary f

-- 1. TIME JOINS
LEFT JOIN "public".time_ t1
    ON f.year_ = t1.year_ AND f.month = t1.month AND f.day = t1.day 
    AND f.dayOfWeek = t1.dayofweek AND f.arr_actual_hour = t1.hour 
    AND f.arr_actual_minute = t1.minutes
LEFT JOIN "public".time_ t2
    ON f.year_ = t2.year_ AND f.month = t2.month AND f.day = t2.day 
    AND f.dayOfWeek = t2.dayofweek AND f.arr_estimated_hour = t2.hour 
    AND f.arr_estimated_minute = t2.minutes
LEFT JOIN "public".time_ t3
    ON f.year_ = t3.year_ AND f.month = t3.month AND f.day = t3.day 
    AND f.dayOfWeek = t3.dayofweek AND f.dep_actual_hour = t3.hour 
    AND f.dep_actual_minute = t3.minutes
LEFT JOIN "public".time_ t4
    ON f.year_ = t4.year_ AND f.month = t4.month AND f.day = t4.day 
    AND f.dayOfWeek = t4.dayofweek AND f.dep_estimated_hour = t4.hour 
    AND f.dep_estimated_minute = t4.minutes

-- 2. DELAY JOINS
LEFT JOIN "public".delay d1 
    ON f.reason = d1.reason AND f.arr_delay = d1.time_delay
LEFT JOIN "public".delay d2 
    ON f.reason = d2.reason AND f.dep_delay = d2.time_delay

-- 3. WEATHER JOINS (Origin)
LEFT JOIN "public".weather_temporary tw_orig
    ON f.station_id_origin = tw_orig.id
    AND f.date = tw_orig.date
LEFT JOIN "public".weather w_orig
    ON tw_orig.precip = w_orig.precipitation
    AND tw_orig.t_max = w_orig.max_temp 
	AND tw_orig.t_min = w_orig.min_temp
    AND tw_orig.snowfall = w_orig.snowfall 
	AND tw_orig.snowfall_d = w_orig.snowfall_depth

-- 4. WEATHER JOINS (Destination)
LEFT JOIN "public".weather_temporary tw_dest
    ON f.station_id_dest = tw_dest.id
    AND f.date = tw_dest.date
LEFT JOIN "public".weather w_dest
    ON tw_dest.precip = w_dest.precipitation
    AND tw_dest.t_max = w_dest.max_temp 
    AND tw_dest.t_min = w_dest.min_temp
    AND tw_dest.snowfall = w_dest.snowfall 
    AND tw_dest.snowfall_d = w_dest.snowfall_depth;
</sql>
