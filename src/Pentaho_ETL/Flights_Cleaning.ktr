    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here


var reasons = [];

// IMPORTANT: Check your field names in the 'Select Values' step!
// If they are lowercase, use lowercase here.
if (carrier_delay > 0)          reasons.push("Carrier");
if (weather_delay > 0)          reasons.push("Weather");
if (nas_delay > 0)              reasons.push("National Air System");
if (security_delay > 0)         reasons.push("Security");
if (late_aircraft_delay > 0)    reasons.push("Late Aircraft");

var reason = (reasons.length > 0) ? reasons.join(",") : "No Delay";</jsScript_script>
      </jsScript>
    </jsScripts>
