    <connection>TAD</connection>
    <sql>SELECT DISTINCT
    f.origin_id,
    f.destination_id,
    m.citymarketid_1,
    m.citymarketid_2,
    m.passengers,
    m.fare,
    m."Year",
    m.quarter
FROM "public".flights_temporary f
INNER JOIN "public".market_temporary m 
    ON f.market_id_origin = m.citymarketid_1 
    AND f.market_id_dest = m.citymarketid_2
ORDER BY f.origin_id, f.destination_id;</sql>
