    <connection>TAD</connection>
    <sql>SELECT DISTINCT 
    origin_id AS id, 
    city_origin AS city, 
    state_origin AS state, 
    origin_latitude AS latitude, 
    origin_longitude AS longitude
FROM "public".flights_temporary

UNION

SELECT DISTINCT 
    destination_id AS id, 
    city_dest AS city, 
    state_dest AS state, 
    dest_latitude AS latitude, 
    dest_longitude AS longitude
FROM "public".flights_temporary

ORDER BY id;</sql>
