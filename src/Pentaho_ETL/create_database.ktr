    <sql>CREATE TABLE "public".flights_temporary
(
  year_ BIGINT
, quarter BIGINT
, "month" BIGINT
, "day" BIGINT
, dayOfWeek BIGINT
, ORIGIN_ID BIGINT
, city_origin VARCHAR(255)
, state_origin VARCHAR(10)
, DESTINATION_ID BIGINT
, city_dest VARCHAR(255)
, state_dest VARCHAR(10)
, dep_estimated BIGINT
, dep_actual INTEGER
, dep_delay INTEGER
, arr_estimated BIGINT
, arr_actual INTEGER
, arr_delay INTEGER
, cancellation_status BOOLEAN
, cancellation_code VARCHAR(512)
, diverted_status BOOLEAN
, estimated_duration NUMERIC(10, 2)
, actual_duration NUMERIC(10, 2)
, distance NUMERIC(10, 2)
, market_id_origin BIGINT
, origin_latitude NUMERIC(19, 8)
, origin_longitude NUMERIC(20, 8)
, market_id_dest BIGINT
, dest_latitude NUMERIC(19, 8)
, dest_longitude NUMERIC(20, 8)
, station_id_origin VARCHAR(50)
, station_id_dest VARCHAR(50)
, dep_actual_hour BIGINT
, dep_actual_minute BIGINT
, dep_estimated_hour BIGINT
, dep_estimated_minute BIGINT
, arr_actual_hour BIGINT
, arr_actual_minute BIGINT
, arr_estimated_hour BIGINT
, arr_estimated_minute BIGINT
, "date" DATE
, reason TEXT
)
;

CREATE TABLE weather_temporary (
    id VARCHAR(50),  -- This is the 'id' from your image
    date DATE,       -- This is the 'date' from your image
    precip BIGINT,
    t_min BIGINT,
    t_max BIGINT,
    snowfall BIGINT,
    snowfall_d BIGINT
);

CREATE TABLE "public".market_temporary
(
  "Year" BIGINT
, quarter BIGINT
, citymarketid_1 BIGINT
, citymarketid_2 BIGINT
, passengers BIGINT
, fare INTEGER
)
;

CREATE TABLE flight (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    distance            NUMERIC(10, 2),
    diverted_status     BOOL,
    estimated_duration  NUMERIC(10, 2), 
    actual_duration     NUMERIC(10, 2),
    cancellation_status BOOL,
    cancellation_reason VARCHAR(512),
    weather_arrival     BIGINT NOT NULL,
    weather_departure   BIGINT NOT NULL,
    time_dep_actual     BIGINT NOT NULL,
    time_dep_estimated  BIGINT NOT NULL,
    time_arr_actual     BIGINT NOT NULL,
    time_arr_estimated  BIGINT NOT NULL,
    airport_arrival     BIGINT NOT NULL,
    airport_departure   BIGINT NOT NULL,
    delay_arrival       BIGINT NOT NULL,
    delay_departure     BIGINT NOT NULL
);

CREATE TABLE time_ (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    day BIGINT,
    month BIGINT,
    year_ BIGINT,
    dayofweek BIGINT,
    quarter BIGINT,
    hour BIGINT,
    minutes BIGINT
);

CREATE TABLE airport (
	id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	city	 VARCHAR(512),
	state	 VARCHAR(512),
	longitude DOUBLE PRECISION NOT NULL,
	latitude	 DOUBLE PRECISION NOT NULL
);

CREATE TABLE weather (
	id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	precipitation	 BIGINT,
	max_temp	 BIGINT,
	min_temp	 BIGINT,
	snowfall	 BIGINT,
	snowfall_depth BIGINT
);

CREATE TABLE delay (
	id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	reason	 VARCHAR(512),
	time_delay INTEGER
);

CREATE TABLE market_traffic (
	id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
	fares		 BIGINT,
	passengers_daily BIGINT,
	time_id	 BIGINT NOT NULL,
	airport_arrival	 BIGINT NOT NULL,
	airport_departure	 BIGINT NOT NULL
);

ALTER TABLE flight ADD CONSTRAINT flight_fk1 FOREIGN KEY (weather_arrival) REFERENCES weather(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk2 FOREIGN KEY (weather_departure) REFERENCES weather(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk3 FOREIGN KEY (time_dep_actual) REFERENCES time_(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk4 FOREIGN KEY (time_dep_estimated) REFERENCES time_(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk5 FOREIGN KEY (time_arr_actual) REFERENCES time_(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk6 FOREIGN KEY (time_arr_estimated) REFERENCES time_(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk8 FOREIGN KEY (airport_arrival) REFERENCES airport(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk9 FOREIGN KEY (airport_departure) REFERENCES airport(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk10 FOREIGN KEY (delay_arrival) REFERENCES delay(id);
ALTER TABLE flight ADD CONSTRAINT flight_fk11 FOREIGN KEY (delay_departure) REFERENCES delay(id);
ALTER TABLE market_traffic ADD CONSTRAINT market_traffic_fk1 FOREIGN KEY (time_id) REFERENCES time_(id);
ALTER TABLE market_traffic ADD CONSTRAINT market_traffic_fk2 FOREIGN KEY (airport_arrival) REFERENCES airport(id);
ALTER TABLE market_traffic ADD CONSTRAINT market_traffic_fk3 FOREIGN KEY (airport_departure) REFERENCES airport(id);
</sql>
