        </named-connections>
        <relation type='collection'>
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='flight' table='[project].[flight]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='airport' table='[project].[airport]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='airport1' table='[project].[airport]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='Custom SQL Query1' type='text'>WITH QuarterWeather AS (&#13;
    SELECT &#13;
        t.year_, &#13;
        t.quarter, &#13;
        f.airport_arrival AS airport_id,&#13;
        COUNT(CASE WHEN w.precipitation &gt;&gt; 250 THEN 1 END) AS stormy_days_count&#13;
    FROM flight f&#13;
    JOIN weather w ON f.weather_arrival = w.id&#13;
    JOIN time_ t ON f.time_dep_estimated = t.id&#13;
    GROUP BY t.year_, t.quarter, f.airport_arrival&#13;
)&#13;
SELECT &#13;
    a.city,&#13;
    a.id AS airport_id,&#13;
    mt.fares,&#13;
    CASE &#13;
        WHEN qw.stormy_days_count &gt;&gt; 18 THEN &apos;Stormy Quarter&apos; &#13;
        ELSE &apos;Clear Quarter&apos; &#13;
    END AS quarter_type&#13;
FROM market_traffic mt&#13;
JOIN time_ t_mt ON mt.time_id = t_mt.id&#13;
JOIN QuarterWeather qw ON t_mt.year_ = qw.year_ &#13;
                       AND t_mt.quarter = qw.quarter &#13;
                       AND mt.airport_arrival = qw.airport_id&#13;
JOIN airport a ON qw.airport_id = a.id</_.fcp.ObjectModelSharedDimensions.true...relation>
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='delay1' table='[project].[delay]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='delay' table='[project].[delay]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='time_' table='[project].[time_]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='time_3' table='[project].[time_]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='time_4' table='[project].[time_]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='time_1' table='[project].[time_]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='weather1' table='[project].[weather]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='weather' table='[project].[weather]' type='table' />
          <relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='market_traffic' table='[project].[market_traffic]' type='table' />
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='Custom SQL Query' type='text'>SELECT &#13;
    d.id AS delay_id,&#13;
    mt.id AS market_traffic_id,&#13;
    t_flight.year_ AS flight_year,&#13;
    t_flight.quarter AS flight_quarter,&#13;
    passengers_daily,&#13;
    d.time_delay&#13;
FROM &quot;project&quot;.flight f&#13;
JOIN &quot;project&quot;.time_ t_flight ON f.time_dep_estimated = t_flight.id&#13;
JOIN &quot;project&quot;.time_ t_market ON t_flight.year_ = t_market.year_ &#13;
                             AND t_flight.quarter = t_market.quarter&#13;
JOIN &quot;project&quot;.market_traffic mt ON t_market.id = mt.time_id &#13;
                                AND f.airport_arrival = mt.airport_arrival&#13;
                                AND f.airport_departure = mt.airport_departure&#13;
JOIN &quot;project&quot;.delay d ON f.delay_arrival = d.id</_.fcp.ObjectModelSharedDimensions.true...relation>
          <_.fcp.ObjectModelSharedDimensions.true...relation connection='postgres.1l8l2tz10hdd6w10o5x1q1t289xj' name='Custom SQL Query2' type='text'>WITH DepartureStats AS (&#13;
    -- Step 1: Calculate cancellation rate per quarter and DEPARTURE airport&#13;
    SELECT &#13;
        t.year_, &#13;
        t.quarter, &#13;
        f.airport_departure,&#13;
        COUNT(f.id) AS total_flights,&#13;
        SUM(CASE WHEN f.cancellation_status = TRUE THEN 1 ELSE 0 END) AS canceled_flights&#13;
    FROM flight f&#13;
    JOIN time_ t ON f.time_dep_estimated = t.id&#13;
    GROUP BY t.year_, t.quarter, f.airport_departure&#13;
)&#13;
SELECT &#13;
    mt.id AS market_id,&#13;
    mt.fares,&#13;
    ds.year_,&#13;
    ds.quarter,&#13;
    a_dep.city AS departure_city,&#13;
    a_dep.state AS departure_state,&#13;
    -- Step 2: Calculate percentage&#13;
    (CAST(ds.canceled_flights AS FLOAT) / NULLIF(ds.total_flights, 0)) * 100 AS cancellation_rate_pct&#13;
FROM market_traffic mt&#13;
JOIN time_ t_mt ON mt.time_id = t_mt.id&#13;
JOIN DepartureStats ds ON t_mt.year_ = ds.year_ &#13;
                          AND t_mt.quarter = ds.quarter &#13;
                          AND mt.airport_departure = ds.airport_departure&#13;
JOIN airport a_dep ON mt.airport_departure = a_dep.id</_.fcp.ObjectModelSharedDimensions.true...relation>
        </relation>
