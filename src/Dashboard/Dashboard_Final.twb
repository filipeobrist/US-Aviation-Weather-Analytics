      <aliases enabled='yes' />
      <column caption='Weather Event (Arr)' datatype='string' name='[Calculation_0540478484598789]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [precipitation] &gt; 250 &#13;&#10;THEN &quot;Stormy&quot; &#13;&#10;ELSE &quot;Clear&quot; &#13;&#10;END' />
      </column>
      <column caption='Weather Classification' datatype='string' name='[Calculation_1576424947535872]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ZN([precipitation (weather1)]) &gt; 1000 THEN &quot;Severe Rain&quot;&#13;&#10;ELSEIF ZN([precipitation (weather1)]) &gt; 250 THEN &quot;Heavy Rain&quot;&#13;&#10;ELSEIF ZN([snowfall (weather1)]) &gt; 250 THEN &quot;Heavy Snow&quot;&#13;&#10;ELSE &quot;Standard Weather&quot;&#13;&#10;END' />
      </column>
      <column caption='Cancelled' datatype='integer' name='[Calculation_1579242211258368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [cancellation_status] THEN 1 ELSE 0 END' />
      </column>
      <column caption='Weather Event (Dep)' datatype='string' name='[Calculation_1579242237788167]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [precipitation (weather1)] &gt; 250 &#13;&#10;THEN &quot;Stormy&quot; &#13;&#10;ELSE &quot;Clear&quot; &#13;&#10;END' />
      </column>
      <column caption='Year-Quarter' datatype='string' name='[Calculation_1579242282926102]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([year_ (time_1)]) + &quot;-Q&quot; + STR([quarter (time_1)])' />
      </column>
      <column caption='Count Stormy' datatype='integer' name='[Calculation_1579242283233303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_1579242282926102] : SUM(IF [Calculation_1579242237788167] = &quot;Stormy&quot; THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Avg Stormy' datatype='real' name='[Calculation_1579242283388952]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([Calculation_1579242283233303]) }' />
      </column>
      <column caption='Stormy Quarter' datatype='string' name='[Calculation_1579242283528217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1579242283233303] &gt; [Calculation_1579242283388952]&#13;&#10;THEN &quot;Stormy Quarter&quot;&#13;&#10;ELSE &quot;Clear Quarter&quot;&#13;&#10;END' />
      </column>
      <column caption='Cancellation Count' datatype='integer' name='[Calculation_1579242287923228]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [cancellation_status] THEN 1 ELSE 0 END)' />
      </column>
      <column caption='CncaellationinPercentage' datatype='real' name='[Calculation_6505535426056194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[cancellation_rate_pct]/100' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_6505535429120003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='' />
      </column>
      <column caption='Date_To_Date' datatype='date' name='[Calculation_6505535429197828]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(&#13;&#10;  CASE [quarter (time_1)]&#13;&#10;    WHEN 1 THEN STR([year_ (time_1)]) + &quot;-01-01&quot;&#13;&#10;    WHEN 2 THEN STR([year_ (time_1)]) + &quot;-04-01&quot;&#13;&#10;    WHEN 3 THEN STR([year_ (time_1)]) + &quot;-07-01&quot;&#13;&#10;    WHEN 4 THEN STR([year_ (time_1)]) + &quot;-10-01&quot;&#13;&#10;  END&#13;&#10;)' />
      </column>
